# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.

# Senha de acesso ao painel (vazio = sem login, use só em rede local)
APP_SENHA=

# Telegram: crie o bot com o @BotFather e descubra seu chat_id (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (opcional)
EMAIL_ATIVO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINO=

# Fuso e horários dos jobs (formato HH:MM)
TZ=America/Fortaleza
HORA_COLETA=06:00
# Editais saem o dia inteiro: repete a coleta de N em N horas (24 = uma só)
HORAS_ENTRE_COLETAS=3
# Hora padrão dos alertas que não escolheram uma própria (veja /perfis)
HORA_ALERTA=07:00

# Janela de busca: propostas que encerram em até N dias
DIAS_JANELA_FUTURA=90
